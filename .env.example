# ==============================================================================
# CITY ÉLECTRONIQUE - ENVIRONMENT CONFIGURATION (PHASE 1)
# ==============================================================================

# Database Connection (PostgreSQL)
# Local example: postgresql://postgres:postgres@localhost:5432/city_electronique
# Cloud/Container example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/city_electronique"

# Application Security
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-secure-random-32-byte-secret-key"
NODE_ENV="development"

# Store Configuration
STORE_NAME="CITY Électronique"
STORE_PHONE="+212600000000"
STORE_WHATSAPP_NUMBER="212600000000"
STORE_CURRENCY="MAD"
STORE_TIMEZONE="Africa/Casablanca"

# Catalog & Safety Parameters
# Maximum drop percentage allowed for full snapshot without explicit admin override (default: 15%)
IMPORT_SAFETY_MAX_DROP_PERCENTAGE="15"

# Integration Feature Flags (Disabled by default)
GLOVO_INTEGRATION_ENABLED="false"
UNICENTA_INTEGRATION_ENABLED="false"

# Existing Runtime Variables
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
